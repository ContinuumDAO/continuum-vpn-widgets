# Pinned obfuscator releases bundled into the Ubuntu package.
SHADOWSOCKS_TAG=v1.25.0
SHADOWSOCKS_ASSET=shadowsocks-v1.25.0.x86_64-unknown-linux-musl.tar.xz
WG_OBFUSCATOR_TAG=v1.6
WG_OBFUSCATOR_ASSET=wg-obfuscator-v1.6-linux-x64.tar.gz
UDP2RAW_TAG=20230206.0
UDP2RAW_ASSET=udp2raw_binaries.tar.gz
UDP2RAW_INNER=udp2raw_amd64
# macOS app. Same Shadowsocks and wg-obfuscator tags. udp2raw is not bundled.
SHADOWSOCKS_ASSET_DARWIN_ARM=shadowsocks-v1.25.0.aarch64-apple-darwin.tar.xz
SHADOWSOCKS_ASSET_DARWIN_X64=shadowsocks-v1.25.0.x86_64-apple-darwin.tar.xz
WG_OBFUSCATOR_ASSET_DARWIN_ARM=wg-obfuscator-v1.6-macos-arm64.zip
WG_OBFUSCATOR_ASSET_DARWIN_X64=wg-obfuscator-v1.6-macos-x64.zip
WIREGUARD_GO_TAG=0.0.20250522
PYTHON_STANDALONE_TAG=20261001
PYTHON_STANDALONE_ARM=cpython-3.12.15+20261001-aarch64-apple-darwin-install_only_stripped.tar.gz
PYTHON_STANDALONE_X64=cpython-3.12.15+20261001-x86_64-apple-darwin-install_only_stripped.tar.gz
# Windows app. The mingw sslocal build does not need the Visual C++ runtime. udp2raw has no Windows binary in the pinned release.
SHADOWSOCKS_ASSET_WINDOWS=shadowsocks-v1.25.0.x86_64-pc-windows-gnu.zip
WG_OBFUSCATOR_ASSET_WINDOWS=wg-obfuscator-v1.6-windows-x64.zip
PYTHON_EMBED_VERSION=3.12.9
PYTHON_EMBED_WINDOWS=python-3.12.9-embed-amd64.zip
