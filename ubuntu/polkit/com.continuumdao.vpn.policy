<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ContinuumDAO</vendor>
  <vendor_url>https://github.com/ContinuumDAO/continuum-vpn-widgets</vendor_url>
  <action id="com.continuumdao.vpn.helper">
    <description>Start the Continuum VPN transport</description>
    <message>Authentication is required to start the Continuum VPN transport</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/continuum-vpn/priv-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
