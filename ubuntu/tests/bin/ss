#!/usr/bin/env python3
"""Pretend a local port is listening when a marker file exists."""

import os
import re
import sys

text = " ".join(sys.argv[1:])
match = re.search(r":(\d+)", text)
port = match.group(1) if match else ""
listen = os.environ.get("CONTINUUM_VPN_LISTEN_DIR", "")
if port and os.path.isfile(os.path.join(listen, port)):
    print(f"udp LISTEN 0 0 127.0.0.1:{port}")
