#!/usr/bin/env python3
"""Stand-in sslocal. Records the listen port from the config and stays running."""

import json
import os
import sys
import time

config = ""
args = sys.argv[1:]
if "-c" in args:
    config = args[args.index("-c") + 1]
port = 51821
if config:
    with open(config, encoding="utf-8") as handle:
        data = json.load(handle)
    port = int(data.get("local_port") or data["locals"][0]["local_port"])
listen = os.environ.get("CONTINUUM_VPN_LISTEN_DIR")
if listen:
    with open(os.path.join(listen, str(port)), "w", encoding="utf-8") as handle:
        handle.write("up\n")
time.sleep(30)
