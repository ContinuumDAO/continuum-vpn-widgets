#!/usr/bin/env python3
"""Stand-in wg-obfuscator."""

import os
import re
import sys
import time

config = ""
args = sys.argv[1:]
if "--config" in args:
    config = args[args.index("--config") + 1]
text = open(config, encoding="utf-8").read() if config else ""
match = re.search(r"(?im)^source-lport\s*=\s*(\d+)", text)
port = match.group(1) if match else "51821"
listen = os.environ.get("CONTINUUM_VPN_LISTEN_DIR")
if listen:
    with open(os.path.join(listen, port), "w", encoding="utf-8") as handle:
        handle.write("up\n")
time.sleep(30)
